mirrors:
{% for host in registry_hosts %}
  "{{ host }}":
    endpoint:
      - "http://{{ host }}"
{% endfor %}
  "docker.io":
    "endpoint":
      - "https://registry-1.docker.io"
configs:
{% for host in registry_hosts %}
  "{{ host }}":
    "auth":
      "username": {{ registry_auth.username | to_json }}
      "password": {{ registry_auth.password | to_json }}
    "tls":
      "insecure_skip_verify": true
{% endfor %}
